[gd_scene format=3]

[ext_resource type="Script" path="res://core/audio/broadcast_schedule.gd" id="script"]
[ext_resource type="AudioStream" path="res://assets/audio/shortwave_radio/relay.wav" id="relay"]
[ext_resource type="AudioStream" path="res://assets/audio/shortwave_radio/dispatch.wav" id="dispatch"]
[ext_resource type="AudioStream" path="res://assets/audio/shortwave_radio/shelter.wav" id="shelter"]
[ext_resource type="AudioStream" path="res://assets/audio/shortwave_radio/carrier.wav" id="carrier"]

[node name="SignalTimer" type="Timer"]
script = ExtResource("script")
one_shot = true
transmissions = Array[AudioStream]([ExtResource("relay"), ExtResource("dispatch"), ExtResource("shelter"), ExtResource("carrier")])
