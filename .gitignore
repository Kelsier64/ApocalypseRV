# Godot 4+ specific ignores
.godot/
/android/
.worktrees/

# Editor backups and local agent settings
*.blend1
.claude/settings.local.json

# Local Slender Speaker authoring and review outputs
/art_source/slender_speaker/
/docs/validation/
/assets/models/slender_speaker/slender_speaker.glb*
/assets/models/slender_speaker/slender_speaker_ss_*
/assets/models/slender_speaker/asset_audit.json
/assets/audio/slender_speaker/manifest.json
/tests/slender_speaker_workshop.*
/tests/slender_speaker_animation_workshop.*
/tests/slender_speaker_world_review.*
/tests/test_slender_speaker_asset.*

# Claude Code local settings
.claude/settings.local.json

# Python bytecode from build scripts
__pycache__/
*.pyc

# REAPER work files for music sources (renders, backups, recorded media)
/art_source/music/**/Backups/
/art_source/music/**/Media/
/art_source/music/**/renders/
