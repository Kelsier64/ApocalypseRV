extends RefCounted
## Read-only reference shared by the terminal's searchable pages.
const ENTRIES := [
	{"id": "driving", "title": "Driving and parking", "tags": "driver seat throttle brake reverse gears handbrake", "body": "Hold E at the driver's seat to board. B starts or stops the engine; Space toggles the handbrake. W applies throttle, S applies the foot brake, and A/D steer. Z selects reverse, X neutral, C first gear, R shifts up, and T shifts down. Stop before changing direction. E leaves the seat. Park fully inside the marked bay, stop, apply the handbrake and switch off the engine."},
	{"id": "battery", "title": "Battery and power", "tags": "charge energy socket exchange swap electricity", "body": "Stop the RV. Select a battery with 1-6 or the mouse wheel, then tap E at the battery socket to install or exchange it. The old battery returns to the same inventory slot. Hold E at the socket to remove its battery; this needs a free inventory slot. Mounted devices need a working connection and battery charge. Opening a terminal costs 0.2 charge; power loss closes it."},
	{"id": "rvctl", "title": "RV controls and lights", "tags": "tablet shell cabin lighting device enable terminal", "body": "Hold E at the vehicle tablet. Enter rvctl in its shell and press Enter to open RV controls. Use the lighting and equipment pages to inspect devices and toggle cabin, work and service lights. The shell's status command reads RV status; help lists commands. L toggles headlights while driving. The training terminal provides instructions; vehicle construction is operated from the vehicle tablet."},
	{"id": "placement", "title": "Item placement and removal", "tags": "equipment mount fixed loose preview rotate cancel support", "body": "Tap E to pick up a loose item, select it in inventory, then tap F to start placement. Hold F at a mounted item to remove it. Left click confirms a valid placement; right click or Esc cancels. R switches surface and upright placement. Q/E rotate by 15 degrees, or 5 degrees with Shift; arrow keys move the preview by 5 cm. A preview is not an installed item. Devices on a lost support fall loose and stop operating."},
	{"id": "recycling", "title": "Recycling", "tags": "recycle dismantler disassemble scrapper materials metal resource", "body": "Mount and enable the scrapper on a powered RV. Drop loose scrap into its hopper with G, or hold E at it while carrying a large item to feed that item directly. Wait for processing to finish and materials to enter RV storage. A preview, cancelled operation, rejected item or pending job yields no completed recycling transaction. An item being recycled cannot be used or picked up."},
	{"id": "crafting", "title": "Crafting and output", "tags": "craft fabricator workbench recipe gas can print queue materials", "body": "Mount and enable the crafting station on a powered RV. Open the vehicle tablet, enter rvctl, choose the crafting page and select a recipe. A queued job reserves its material cost and needs power to run. Keep the output area clear. A completed print creates a loose physical item at the station; tap E to collect it. Queuing a gas can alone does not put it in your inventory."},
	{"id": "structure", "title": "Structure repair and rebuilding", "tags": "wall roof door panel construction metal health repair", "body": "Park, stop the engine and apply the handbrake. Open rvctl on the vehicle tablet and select a structure slot. Repair restores a damaged panel; rebuilding restores a missing panel, and changing its type replaces it with the selected variant. Check the shown material cost and wait for the operation to finish. Closing the tablet or losing its service cancels construction. Attached items lose support when their panel is removed. The chassis floor is fixed and has no construction slot."},
	{"id": "engine", "title": "Engine service", "tags": "repair kit hatch maintenance original engine replace health", "body": "Stop, turn the engine off and apply the handbrake. Open the front maintenance hatch completely. Select an engine repair kit, aim at the engine and hold H for three seconds to repair it; a successful repair consumes one kit. Select a replacement engine and tap E at the bay to exchange it, or hold E to remove it. Engine replacement is different from repairing the original engine. Close the hatch before driving."},
	{"id": "tire", "title": "Tires and wheel slots", "tags": "wheel puncture flat spare remove install repair", "body": "Stop the RV and switch the engine off. With no spare wheel selected, hold E at the damaged wheel slot to remove its tire onto the ground. Select a healthy spare wheel, aim at that same empty slot and hold E to install it. A punctured tire reduces grip and can pull the RV sideways. Holding H for two seconds can repair a serviceable wheel slot or device for two metal. Replacing a tire requires the healthy spare to be installed in the intended slot."},
	{"id": "refueling", "title": "Refueling", "tags": "refuel fuel petrol gasoline gas can tank port", "body": "Select a gas can in inventory, aim at the RV fuel port and tap E. A successful refuel adds fuel up to tank capacity and returns an empty can to inventory. A full tank cannot accept another can. During training, use the gas can printed by the designated crafting station at the designated RV."},
	{"id": "departure", "title": "Shelter departure and training records", "tags": "depart exit gate start journey completed skipped restart skip checkpoint", "body": "Finish the current Conditions page before proceeding through each bay gate. At the final bay, park inside, stop, apply the handbrake and switch off the engine. Read the final briefing, then press the departure button. Board and drive the whole RV beyond the shelter exit. Keep the exit clear while the gate closes; an obstruction reopens it. Completed training unlocks this manual on the same terminal. Esc > Skip Tutorial also unlocks it with a Skipped record and releases the shelter route. Esc > Restart Stage restores that stage's entrance while training is active; it leaves the manual checkpoint unchanged."},
	{"id": "controls", "title": "Key reference", "tags": "keys controls keyboard shortcut inventory flashlight save load", "body": "Walking: WASD, mouse look, Shift sprint, Space jump. Ladder: W up, S down, Space leave. Interaction: tap E; hold E for seats and fixed devices. Inventory: 1-6 or wheel select, G drop; L toggles a held flashlight. Placement: F start, hold F remove, left click confirm, right click / Esc cancel, R mode, Q/E rotate, Shift fine rotation, arrows move. Service: hold H repair. Driving: W throttle, S brake, A/D steer, Space handbrake, B engine, Z reverse, X neutral, C first gear, R/T shift, L headlights, E leave seat. Terminal: F1-F4 pages, Tab focus, Enter select, Esc close. F6 saves and F9 loads outdoors when unseated and idle; moving gates and active interactions block saving. Esc opens settings after closing other interfaces."}
]

static func search(query: String) -> Array[Dictionary]:
	var words := query.to_lower().replace("\t", " ").replace("\n", " ").split(" ", false)
	var matches: Array[Dictionary] = []
	for entry: Dictionary in ENTRIES:
		var searchable: String = (entry.title + " " + entry.tags + " " + entry.body).to_lower()
		var matched := true
		for word: String in words:
			if not searchable.contains(word):
				matched = false
				break
		if matched: matches.append(entry.duplicate(true))
	return matches

static func format(query: String = "") -> String:
	var sections := PackedStringArray()
	for entry: Dictionary in search(query): sections.append(entry.title + "\n" + entry.body)
	return "\n\n".join(sections) if not sections.is_empty() else "No matching entries."
